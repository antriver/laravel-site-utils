{
    "name": "antriver/laravel-site-utils",
    "description": "A bunch of stuff to help building Laravel apps.",
    "type": "library",
    "authors": [
        {
            "name": "Anthony Kuske",
            "homepage": "https://anthonykuske.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Antriver\\LaravelSiteUtils\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Antriver\\LaravelSiteUtilsTests\\": "tests/",
            "Antriver\\LaravelSiteUtilsTestApp\\": "test-laravel-app/app/"
        }
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-openssl": "*",
        "antriver/laravel-database-session-auth": "^6.0",
        "antriver/laravel-model-presenters": "^1.0",
        "antriver/laravel-registers": "^6.0",
        "antriver/laravel-repositories": "^13.0.1",
        "antriver/laravel-simple-message-trait": "^5.8",
        "aws/aws-php-sns-message-validator": "^1.10",
        "erusev/parsedown": "^1.8",
        "firebase/php-jwt": "^7.2",
        "google/recaptcha": "^1.3.1 || ^2.1",
        "intervention/image": "^4.4",
        "laravel/framework": "^12.0 || ^13.0",
        "laravel/socialite": "^5.32",
        "league/flysystem-aws-s3-v3": "^3.35",
        "tokenly/token-generator": "^1.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.8",
        "fakerphp/faker": "^1.24",
        "phpunit/phpunit": "^12.5 || ^13.4"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Antriver\\LaravelSiteUtils\\Providers\\LaravelSiteUtilsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
